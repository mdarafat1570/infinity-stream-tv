# Copy to .env for local customization. Never commit .env or instance/.
APP_ENV=development
SITE_URL=http://localhost:5000
# Required in production: generate with python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Optional: defaults to the ignored instance/enquiries.sqlite3 file.
# DATABASE_PATH=C:/path/to/private/enquiries.sqlite3
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW=600
# Production reverse proxy: set only when that many trusted proxies are in front.
TRUST_PROXY_COUNT=0
# Optional comma-separated hostnames. Production defaults to SITE_URL's hostname.
# TRUSTED_HOSTS=example.com,www.example.com
